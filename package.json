{
  "name": "@local/deepseek-usage",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek API balance, token usage, and daily trend dashboard for the Harness Web UI.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "usage",
    "balance",
    "tokens"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/myname1234/dsh-deepseek-usage"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/icon-180.png",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
